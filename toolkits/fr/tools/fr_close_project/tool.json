{
  "tool_id": "01a1b302-6efc-75a4-b598-d983d9dedb40",
  "public_name": "fr_close_project",
  "operation": "fr.close_project",
  "effect": "writes",
  "runtime": "fr_command",
  "target": {
    "kind": "fr_command",
    "command": "projects.close"
  },
  "description": "Close one fr project in the calling tenant's fr workspace as the agent member, through fr's signed `mcp` channel command `projects.close {\"id\":\"<uuid>\"}`. Answers with the closed project: status, phase, the delivery evidence and deliverables when fr recorded them, plus closed/already_closed (a second close is not an error) and rm_pm_project_id. Side effect: closes the project in fr; closing an already closed project changes nothing.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "result_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "project_type": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "delivered_at": {
        "type": "string"
      },
      "delivery_evidence": {},
      "deliverables": {},
      "closed": {
        "type": "boolean"
      },
      "already_closed": {
        "type": "boolean"
      },
      "rm_pm_project_id": {
        "type": "string"
      }
    }
  },
  "limits": {
    "wall_seconds": 60,
    "queue_seconds": 240,
    "memory_mi": 256,
    "cpu_millicores": 250,
    "api_calls": 2,
    "frame_bytes": 262144,
    "output_bytes": 262144
  }
}
