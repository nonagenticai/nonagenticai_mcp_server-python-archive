{
  "tool_id": "01a17240-f94f-764d-bbfe-86d14295f331",
  "public_name": "coding_write_code",
  "operation": "coding.write_code",
  "description": "Write up to 10 files into the workspace, read the change back, then always run lint, a compile check, a quick security scan and the dependency-cycle gate, and return the verdict. Precondition: the workspace runs. Side effects: overwrites the files in the working tree (not committed). TypeScript compile is reported as degraded (tsc is not on the gateway allow-list). If time runs out it returns pending with coding_run_checks as the next tool.",
  "entrypoint": "tool:main",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "container_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "format": "container-name",
        "description": "Workspace name (lowercase letters, digits, hyphens)."
      },
      "language": {
        "enum": [
          "python",
          "go",
          "javascript",
          "typescript"
        ],
        "description": "Primary language; selects the compile check."
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "format": "relative-path"
            },
            "content": {
              "type": "string",
              "maxLength": 60000
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "format": "idempotency-key",
        "description": "Caller-chosen key; repeating the call with the same key and arguments is safe because every step reads state before writing."
      }
    },
    "required": [
      "container_name",
      "language",
      "files",
      "idempotency_key"
    ]
  },
  "effect": "writes",
  "allowed_operations": [
    "workspace_status",
    "git_diff",
    "get_graph",
    "cycle_baseline",
    "write_file",
    "quality_analyze_sync",
    "exec",
    "security_quick",
    "cycle_check"
  ],
  "limits": {
    "wall_seconds": 300,
    "queue_seconds": 180,
    "memory_mi": 256,
    "cpu_millicores": 250,
    "api_calls": 22,
    "frame_bytes": 262144,
    "output_bytes": 262144
  }
}
