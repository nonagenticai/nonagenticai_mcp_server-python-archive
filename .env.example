# Export explicitly; the application never loads .env implicitly.
DATABASE_URL=postgresql://mcp_runtime:REPLACE@127.0.0.1:REPLACE/mcp_catalog  # pragma: allowlist secret
MCP_POOL_MIN_SIZE=1
MCP_POOL_MAX_SIZE=10
MCP_POOL_TIMEOUT_SECONDS=3
MCP_POOL_MAX_WAITING=32
MCP_DATABASE_STATEMENT_TIMEOUT_MS=5000
MCP_HEALTH_TIMEOUT_SECONDS=3
MCP_MAX_PACKAGE_FILES=64
MCP_MAX_PACKAGE_FILE_BYTES=262144
MCP_MAX_PACKAGE_BYTES=1048576
MCP_MAX_SCHEMA_BYTES=65536
MCP_MAX_SCHEMA_DEPTH=16
MCP_MAX_SCHEMA_NODES=1024
MCP_MAX_SCHEMA_REFERENCES=32
MCP_MAX_VALIDATION_WORK=100000
MCP_MAX_INSTANCE_BYTES=1048576
MCP_MAX_INSTANCE_NODES=10000
MCP_MAX_INSTANCE_DEPTH=32
# No approved runner images by default. Operator-provided immutable digests only.
MCP_APPROVED_RUNNER_IMAGES=[]
# Protected work is disabled unless both license settings are supplied.
LICENSE_INTROSPECT_URL=https://licenses.example/license/introspect
MCP_LICENSE_APP_KEY=mcp
# Set true only for an operator-approved internal HTTP introspection destination.
MCP_LICENSE_ALLOW_HTTP=false
LICENSE_CACHE_TTL_SECONDS=30
MCP_LICENSE_CACHE_MAX_ENTRIES=1024
MCP_LICENSE_TIMEOUT_SECONDS=3
MCP_LICENSE_MAX_RESPONSE_BYTES=65536
MCP_LICENSE_EXPIRY_SKEW_SECONDS=2
# Mounted secret files, readable by UID 1000, containing distinct >=32-byte keys.
# Do not store key values here. Explicit JSON array of UUIDv7 tenant IDs.
MCP_ADMIN_KEY_FILE=/run/mcp/admin-key
MCP_ADMIN_TENANT_IDS=[]
# MCP_PLATFORM_ADMIN_KEY_FILE=/run/mcp/platform-admin-key
MCP_MAX_MANAGEMENT_BYTES=262144
MCP_SESSION_TTL_SECONDS=3600

# Per-process HTTP transport bounds; these do not configure execution capacity.
MCP_PROTOCOL_INPUT_BYTES=262144
MCP_PROTOCOL_OUTPUT_BYTES=2097152
MCP_PROTOCOL_MAX_INFLIGHT=32
MCP_PROTOCOL_TIMEOUT_SECONDS=15
MCP_CATALOG_PAGE_SIZE=10

# Remains false until combined synthetic Kata acceptance and coordinated rollout.
MCP_EXECUTION_ENABLED=false
MCP_EXECUTION_GLOBAL_SLOTS=1
MCP_EXECUTION_PER_TENANT_SLOTS=1
MCP_QUEUE_GLOBAL_MAX=100
MCP_QUEUE_PER_TENANT_MAX=20
MCP_RUN_QUEUE_TIMEOUT_SECONDS=60
MCP_RUN_START_TIMEOUT_SECONDS=30
MCP_RUN_MAX_SECONDS=60
MCP_SYNC_WAIT_SECONDS=0
MCP_LEASE_SECONDS=30
MCP_HEARTBEAT_SECONDS=5
MCP_RECONCILE_SECONDS=10
MCP_API_MAX_INFLIGHT=8
MCP_API_MAX_CALLS_PER_MINUTE=60
MCP_API_CONCURRENCY_GLOBAL=8
MCP_API_CONCURRENCY_PER_SERVICE=8
MCP_API_TIMEOUT_SECONDS=30
MCP_API_MAX_RESPONSE_BYTES=262144
MCP_EXECUTION_RETENTION_DAYS=7
MCP_WORKER_PROBE_PORT=8034
# Optional deployment-owned narrowing by exact service/tenant UUIDv7.
# MCP_API_RATE_LIMITS_FILE=/run/mcp-rate-limits/limits.json
MCP_MAX_API_CALLS_PER_RUN=10
MCP_MAX_FRAME_BYTES=65536
MCP_MAX_RESULT_BYTES=262144
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_LOG_BYTES=8192
MCP_MAX_FRAMES=256
# Worker only. Supply a separately scoped worker DATABASE_URL and mounted files.
# MCP_CREDENTIAL_BUNDLE_FILE=/run/mcp-credentials/bundle.json
# MCP_SERVICE_DESTINATIONS_FILE=/run/mcp-destinations/destinations.json
MCP_RUN_NAMESPACE=mcp-runs
# MCP_KATA_RUNTIME_CLASS=kata
# MCP_RUNNER_IMAGE_DIGEST=<registry/repository@sha256:digest>
MCP_RUN_MEMORY_REQUEST_MI=256
MCP_RUN_MEMORY_LIMIT_MI=256
# CPU values are integer millicores, never a caller-controlled runtime profile.
MCP_RUN_CPU_REQUEST=250
MCP_RUN_CPU_LIMIT=250
# Optional platform authoring pool: limited platform role, never migration owner.
# MCP_PLATFORM_DATABASE_URL=<secret-injected-postgresql-url>

# ------------------------------------------------------------------------------
# Builtin provider callers (src/auth/protocol.py, docs/AUTHENTICATION_BINDINGS.md)
# ------------------------------------------------------------------------------
# care-bus tenant licence: X-Tenant-Id: Bearer <care-bus licence> WITHOUT X-MCP-Binding,
# introspected at LICENSE_INTROSPECT_URL (app.key=care-bus, subject_kind=tenant).
# Keycloak service JWT (Authorization: Bearer, /mcp only). Enabled only when all four
# are set (src/auth/keycloak.py); a partial config disables it (fail closed).
# strato: https://auth.nonagentic.ai / portal / nonagenticai-mcp / carebus-tool-executor,carebus-researcher
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_AUDIENCE=
KEYCLOAK_ALLOWED_CLIENTS=

# Binding provisioning: POST /mcp/internal/tenants/{tenant_id}/bindings/ensure, body
# {"product": "agent"|"care-bus", "licence_id": uuid, "licence_token": "<tenant mcp licence>",
# "rotate"?: bool}. The licence token is introspected and must be the tenant's tenant-level mcp
# licence with that id. Authorization: Bearer <Keycloak service JWT>; azp must be in
# KEYCLOAK_ALLOWED_CLIENTS AND here. Empty = 503.
# MCP_BINDING_ENSURE_CLIENTS=["agent-provisioning","carebus-provisioning"]
# Product -> toolkit names (default in src/config.py DEFAULT_PRODUCT_TOOLKITS).
# MCP_BINDING_PRODUCTS={"agent":["coding","knowledge","cases","rules"]}
# MCP_BINDING_ENSURE_TTL_DAYS=365
# Product -> licences bundle the minter names (bundle-token?bundle=); every product needs one.
# MCP_PRODUCT_BUNDLES={"agent":"agent","care-bus":"care-bus"}
# Reserved platform tenant that publishes first-party toolkits (src/config.py PLATFORM_TENANT_ID).
# Must equal public.mcp_platform_tenant() from migration 0008, or readiness fails. Do not change.
# MCP_PLATFORM_TENANT_ID=01900000-0000-7000-8000-00000000f001

# Broker backend credentials minted per tenant by licences (off by default; replaces
# MCP_CREDENTIAL_BUNDLE_FILE in the worker when enabled). Client needs bundle-token-minter.
# MCP_LICENCE_MINTER_ENABLED=false
# MCP_LICENCE_MINTER_TOKEN_URL=https://auth.nonagentic.ai/realms/portal/protocol/openid-connect/token
# MCP_LICENCE_MINTER_CLIENT_ID=mcp-bundle-minter
# MCP_LICENCE_MINTER_SECRET_FILE=/run/mcp-minter/client-secret
# MCP_LICENCE_MINTER_TTL_MINUTES=15
# MCP_LICENCE_MINTER_SKEW_SECONDS=30

# care-bus builtins (src/builtin/carebus). An unset *_URL makes the tool return
# "[permanent] <VAR> is not set on the MCP server".
DEMO_BACKENDS_URL=CHANGE_ME_DEMO_BACKENDS_URL
DEMO_BACKENDS_TOKEN=CHANGE_ME
STRATA_RAG_URL=CHANGE_ME_STRATA_RAG_URL
STRATA_RAG_TOKEN=CHANGE_ME
# faq_ask wall-clock timeout (s); must stay below care-bus TOOL_TIMEOUT_MS_FAQ (20 s)
FAQ_TIMEOUT_S=18
CAREBUS_API_URL=CHANGE_ME_CAREBUS_API_URL
CAREBUS_API_TOKEN=CHANGE_ME

# researcher builtins (src/builtin/{legal,web,research}); URLs default to the public/in-cluster hosts.
WEBSCRAPER_URL=CHANGE_ME_WEBSCRAPER_URL
WEBSCRAPER_TOKEN=CHANGE_ME
WEBSCRAPER_TIMEOUT_S=30
LEGAL_TIMEOUT_S=15
LEGAL_SCRAPE_MIN_INTERVAL_S=1.0
LEGAL_UOKIK_ENABLED=false
# DISCOVERY_ENGINE_URL / DISCOVERY_ENGINE_TOKEN / DISCOVERY_ENGINE_TIMEOUT_S
# SCIENTIFIC_PROCESSOR_URL / SCIENTIFIC_PROCESSOR_TOKEN / SCIENTIFIC_PROCESSOR_TIMEOUT_S
